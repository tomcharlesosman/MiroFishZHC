# LLM API configuration (supports any provider compatible with the OpenAI SDK format)
# Recommended starter model: qwen-plus on Alibaba Bailian: https://bailian.console.aliyun.com/
# Costs can add up quickly, so start with shorter runs under 40 rounds
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== Zep memory graph configuration =====
# The free monthly tier is enough for light usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Firecrawl website ingestion configuration (optional) =====
# Required if you want to use the company website URL input
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ===== Better Auth configuration =====
# Generate with `openssl rand -base64 32`; use at least 32 characters
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
# Better Auth service URL (defaults to local port 5002)
BETTER_AUTH_URL=http://localhost:5002
# Frontend origin used by the auth service and backend for CORS / trusted origins
FRONTEND_ORIGIN=http://localhost:3000
# Auth service URL used by the Flask backend to validate sessions
AUTH_SERVICE_URL=http://localhost:5002

# ===== Accelerated LLM configuration (optional) =====
# If you are not using the accelerated path, leave the settings below out of your real `.env`
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
