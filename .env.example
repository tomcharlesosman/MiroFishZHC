# LLM API configuration (supports any provider compatible with the OpenAI SDK format)
# Recommended starter model: qwen-plus on Alibaba Bailian: https://bailian.console.aliyun.com/
# Costs can add up quickly, so start with shorter runs under 40 rounds
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== Zep memory graph configuration =====
# The free monthly tier is enough for light usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Firecrawl website ingestion configuration (optional) =====
# Required if you want to use the company website URL input
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ===== Privy authentication configuration =====
# App ID from the Privy dashboard
PRIVY_APP_ID=your_privy_app_id
# Frontend Vite variable, usually the same value as PRIVY_APP_ID
VITE_PRIVY_APP_ID=your_privy_app_id
# Optional client ID if you want to pass it explicitly to the Privy JS SDK
VITE_PRIVY_CLIENT_ID=your_privy_client_id
# Access token verification public key from the Privy dashboard
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PRIVY_PUBLIC_KEY\n-----END PUBLIC KEY-----"
# Frontend origin used by the backend for CORS
FRONTEND_ORIGIN=http://localhost:3000

# ===== Accelerated LLM configuration (optional) =====
# If you are not using the accelerated path, leave the settings below out of your real `.env`
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
